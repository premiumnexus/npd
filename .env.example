DEBUG=1
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=cu_food
DB_USER=cu_food
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
# Set in the shell for an explicit SQLite-only local demo:
# CUFOOD_SQLITE=1
# Optional host port for Docker Compose (defaults to 8000):
# WEB_PORT=8001
# Native Python runs read shell environment variables; they do not load this file.
# Docker Compose reads .env and passes selected settings to the web/db services.
# Compose uses DB_HOST=db and DB_PORT=5432, regardless of the values above.
